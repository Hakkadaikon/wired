# moq-interop-runner relay image for wired (draft-ietf-moq-transport
# 18/19/22). One port serves WebTransport (ALPN h3, subprotocol
# moqt-18/moqt-19/moqt-22) and raw QUIC (ALPN moqt-22/moqt-19/moqt-18).
# The runner's `wired-quic` entry (moqt://) is its adapter
# adapters/wired/Dockerfile.relay.quic, a plain re-tag of this image (FROM
# ghcr.io/hakkadaikon/wired-moqt-interop:latest); `wired` uses https://.
#
# The freestanding binary is built OUTSIDE this Dockerfile (it needs the
# repo's pinned clang/ninja toolchain):
#
#   just gen-ninja && ninja examples/moqt_interop/wired_server
#   docker build -t wired-moqt-interop -f interop/Dockerfile.moqt .
#
# busybox supplies the sh + grep the runner's compose healthcheck needs.
FROM busybox:stable

COPY --chmod=755 examples/moqt_interop/wired_server /wired/wired_server
COPY --chmod=755 interop/run_endpoint_moqt.sh /run_endpoint.sh

ENTRYPOINT ["/run_endpoint.sh"]
