BasedOnStyle: Google
IndentWidth: 2
ColumnLimit: 80
# Google style sets DerivePointerAlignment: true (guess from the file), which
# let older clang-format versions silently keep right-aligned pointers; pin it
# off so the declared PointerAlignment is authoritative across versions.
DerivePointerAlignment: false
PointerAlignment: Left
AlignAfterOpenBracket: AlwaysBreak
BinPackParameters: false
AlignConsecutiveAssignments:
  Enabled: true
AlignConsecutiveDeclarations:
  Enabled: true
AlignEscapedNewlines: Left
AlignTrailingComments:
  Kind: Always
# Every if/else/for/while/do body gets braces, one-line bodies included.
# clang-format's own docs warn this can misformat code it cannot fully
# parse (macros); the full test suite and fuzz harnesses are the check.
InsertBraces: true
