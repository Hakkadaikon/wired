# wired MOQT chat sample. libc-free, x86_64-linux only, single-process
# driver only (the hub keeps its peer table in one process's memory -- see
# src/app/moqt/run/moqtrun.h).

# Build the server against the SDK static library, after the SDK's own
# fmt+ninja+lint gate. The static, freestanding binary needs no libc.
build:
    cd ../.. && just build && ninja examples/moqt_chat/wired_server

# Build (via docker-compose.yml's own `build:`) and run in the foreground;
# Ctrl-C stops it. network_mode: host, so the container listens on the
# host's own 4433/udp directly (no NAT/port-forward -- QUIC's Path MTU
# Discovery, IP_MTU_DISCOVER=IP_PMTUDISC_DO, was confirmed by hand to never
# complete a handshake through Docker's default bridge + `-p` port mapping;
# host networking sidesteps it). --build picks up a binary rebuilt since the
# image was last built (docker compose up alone reuses a stale image
# otherwise). Do not pass --workers/--cores/--ifindex: this hub is
# single-process only.
up: build
    docker compose up --build

# Same as `up`, but detached: returns immediately once the container is
# running. `docker compose logs -f` to follow its cert-fingerprint/startup
# output, `just down` to tear it down.
up-bg: build
    docker compose up --build -d

# Stop and remove the container docker-compose.yml started.
down:
    docker compose down

# Production build of the moqt_chat frontend (frontend/, Next.js + pnpm,
# output: "export" -> frontend/out/).
build-frontend:
    cd frontend && pnpm install --frozen-lockfile && pnpm build

# Run the moqt_chat frontend's dev server (http://localhost:3000/).
dev-frontend:
    cd frontend && pnpm install --frozen-lockfile && pnpm dev

# Build the frontend's static output and serve it over TLS
# (https://<host>:8443/). TLS because a non-localhost http:// page is not a
# secure context and the browser disables the WebTransport API entirely.
serve-frontend: build-frontend
    [ -f cert.pem ] || openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:P-256 \
        -keyout key.pem -out cert.pem -days 365 -nodes -subj "/CN=localhost"
    python3 -c "\
    import functools, http.server, ssl; \
    handler = functools.partial(http.server.SimpleHTTPRequestHandler, directory='frontend/out'); \
    srv = http.server.HTTPServer(('0.0.0.0', 8443), handler); \
    ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER); \
    ctx.load_cert_chain('cert.pem', 'key.pem'); \
    srv.socket = ctx.wrap_socket(srv.socket, server_side=True); \
    print('https://0.0.0.0:8443/'); \
    srv.serve_forever()"

# TS codec unit tests (vitest) pinned to the shared golden vectors
# (testvectors/moqt_golden.json).
test-codec:
    cd frontend && pnpm install --frozen-lockfile && pnpm test

# One-time: install the e2e harness's node deps and puppeteer's own Chrome
# for Testing build, then provision the shared libraries that build is
# missing in a minimal container via `apt-get download` + `dpkg -x`
# (user-local, no root, no system mutation), caching the resulting lib path
# at e2e/.chrome-libs-profile.
e2e-setup:
    cd e2e && npm install
    cd e2e && npx puppeteer browsers install chrome
    ./e2e/fetch-chrome-libs.sh

# Unit tests for the load harness's own metrics math (loss rate, latency
# percentiles) -- pure functions, no browser involved.
e2e-test:
    cd e2e && npm test

# Chat+voice load test at the full 4-client room (the shape the voice
# quality gates are defined against). Args forward to run-voice-load-test.mjs.
e2e-voice *ARGS: build build-frontend
    ./e2e/run-voice.sh --clients=4 {{ARGS}}

# One stability scenario (e2e/scenarios/<id>.mjs): the runner owns the
# server process so scenarios can kill/restart it mid-run. Evidence lands in
# tasks/voice-stability/<id>/. e.g.: just e2e-stability s2-chat-longevity
e2e-stability SCENARIO *ARGS: build build-frontend
    ./e2e/run-stability.sh {{SCENARIO}} {{ARGS}}

# Per-change stability battery (the master ledger's CI set): chat
# longevity, clean voice, outage-reconnect, server restart, and 1% voice
# loss. Stops at the first failing scenario; evidence lands per scenario
# under tasks/voice-stability/<id>/.
e2e-stability-ci: build build-frontend
    ./e2e/run-stability.sh s2-chat-longevity
    ./e2e/run-stability.sh s1-voice-clean
    ./e2e/run-stability.sh s4-voice-outage-reconnect
    ./e2e/run-stability.sh s5b-server-restart
    ./e2e/run-stability.sh s3-voice-loss --loss-rate=0.01

# Nightly battery: the CI set plus the endurance runs -- the 25-minute
# 2-client voice soak (S6, flow-control wedge detector) and the 4-client
# voice+chat longevity run (S10).
e2e-stability-nightly: e2e-stability-ci
    ./e2e/run-stability.sh s6-voice-soak --talk-ms=1500000
    ./e2e/run-stability.sh s10-voice-chat-longevity

# Multi-client chat load test: N headless-Chrome clients (each its own
# BrowserContext), joining the hub's single fixed room, exchanging chat
# messages, graded for message loss and latency. N is capped at 4 (the
# frontend's fixed candidate participant id list -- see e2e/lib/loadTest.mjs
# for why). Starts/stops its own server + static frontend; no manual
# fingerprint copying. Run e2e-setup once first.
# Args forward to run-load-test.mjs, e.g.:
#   just e2e-load --clients=4 --messages=10 --max-loss-rate=0
e2e-load *ARGS: build build-frontend
    ./e2e/run.sh {{ARGS}}
