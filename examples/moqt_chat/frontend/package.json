{
	"name": "moqt-chat-frontend",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@10.24.0",
	"scripts": {
		"dev": "next dev",
		"vendor:assets": "mkdir -p public/worklets && cp node_modules/@jitsi/rnnoise-wasm/dist/rnnoise-sync.js public/worklets/ && mkdir -p public/mediapipe && cp node_modules/@mediapipe/tasks-vision/wasm/vision_wasm_internal.js node_modules/@mediapipe/tasks-vision/wasm/vision_wasm_internal.wasm public/mediapipe/",
		"predev": "pnpm vendor:assets",
		"prebuild": "pnpm vendor:assets",
		"build": "next build",
		"start": "next start",
		"test": "vitest run",
		"check": "biome ci --error-on-warnings .",
		"fix": "biome check --write ."
	},
	"dependencies": {
		"@jitsi/rnnoise-wasm": "0.2.1",
		"@mediapipe/tasks-vision": "1.1.1",
		"next": "16.3.3",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"zustand": "^5.0.14"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/node": "^26.1.1",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"fast-check": "^4.9.0",
		"jsdom": "^29.1.1",
		"typescript": "^5.9.3",
		"vitest": "^4.1.10"
	}
}
