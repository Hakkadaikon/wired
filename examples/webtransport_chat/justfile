# wired WebTransport chat sample. libc-free, x86_64-linux only.
# Mirrors examples/word_list/justfile; its ninja target is registered in the
# SDK's scripts/gen_ninja.sh alongside word_list's.

# Build the server against the SDK static library, after the SDK's own
# fmt+ninja+lint gate. The static, freestanding binary needs no libc.
build:
    cd ../.. && just build && ninja examples/webtransport_chat/wired_server

# Build and run (binds 0.0.0.0:4433; Ctrl-C to stop).
run: build
    ./wired_server

# Build and run over AF_XDP instead of a plain UDP socket (root required;
# same flags as examples/word_list, see README.md).
run-xdp: build
    sudo ./wired_server --ifindex $IFINDEX --ip $IP --san-ipv4 $IP --skb-mode

# Production build of the voice chat frontend (frontend/, Next.js + pnpm).
build-frontend:
    cd frontend && pnpm install --frozen-lockfile && pnpm build

# Run the voice chat frontend's dev server (http://localhost:3000/).
dev-frontend:
    cd frontend && pnpm install --frozen-lockfile && pnpm dev

# Build the voice chat frontend's static export and serve it over TLS
# (https://<host>:8443/). TLS because a non-localhost http:// page is not a
# secure context and the browser disables the WebTransport API entirely.
# Uses cert.pem/key.pem from this directory, generating a self-signed pair
# on first run (accept the browser warning once).
serve-frontend: build-frontend
    [ -f cert.pem ] || openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:P-256 \
        -keyout key.pem -out cert.pem -days 365 -nodes -subj "/CN=localhost"
    python3 -c "\
    import functools, http.server, ssl; \
    handler = functools.partial(http.server.SimpleHTTPRequestHandler, directory='frontend/out'); \
    srv = http.server.HTTPServer(('0.0.0.0', 8443), handler); \
    ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER); \
    ctx.load_cert_chain('cert.pem', 'key.pem'); \
    srv.socket = ctx.wrap_socket(srv.socket, server_side=True); \
    print('https://0.0.0.0:8443/'); \
    srv.serve_forever()"

# One-time: install the e2e harness's node deps and puppeteer's own Chrome
# for Testing build, then provision the shared libraries that build is
# missing in a minimal container (atk/cups/cairo/pango/alsa/...) via
# `apt-get download` + `dpkg -x` (user-local, no root, no system mutation),
# caching the resulting lib path at e2e/.chrome-libs-profile.
e2e-setup:
    cd e2e && npm install
    cd e2e && npx puppeteer browsers install chrome
    ./e2e/fetch-chrome-libs.sh

# Unit tests for the load harness's own metrics math (loss rate, latency
# percentiles) -- pure functions, no browser involved. Run before trusting
# e2e-load's numbers after touching lib/metrics.mjs.
e2e-test:
    cd e2e && npm test

# Multi-client chat load test: N headless-Chrome clients (each its own
# BrowserContext), same room, exchanging chat messages, graded for message
# loss and latency. Starts/stops its own server + static frontend; no manual
# fingerprint copying. Run e2e-setup once first.
# Args forward to run-load-test.mjs, e.g.:
#   just e2e-load --clients=5 --messages=10 --max-loss-rate=0
e2e-load *ARGS:
    ./e2e/run.sh {{ARGS}}
