node_modules
/dist/
/.astro/

# runner output written into a snippet's own dir when it exercises
# qlog/keylog (ops-handshake-knobs)
snippets/*/demo.qlog
snippets/*/demo.keylog

# ops-cert-reload seeds/replaces these at runtime; never the source of truth
# (CERT_A/CERT_B in main.c are)
snippets/*/live-cert.pem
snippets/*/live-key.pem
